@@ -25,12 +31,37 @@
     pub fn new(len: usize) -> Self {
         let mut buf = vec![T::default(); len].into_boxed_slice();
         let ptr = buf.as_mut_ptr();
-        ArenaBuf { buf, ptr }
+        ArenaBuf {
+            buf, ptr,
