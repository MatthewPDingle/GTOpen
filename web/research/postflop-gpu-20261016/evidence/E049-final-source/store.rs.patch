 pub struct ArenaBuf<T> {
     buf: Box<[T]>,
     ptr: *mut T,
+    // A borrowed view invalidates this proof before it can escape. Only
+    // concrete i16/u16 callers may infer zero from an untouched default.
+    #[cfg(feature = "gpu")]
