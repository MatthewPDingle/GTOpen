+    #[test]
+    fn training_terminal_consolidation_covers_lists_and_falls_back() {
+        for iso in [false, true] {
+            let solver = reach_reuse_solver(crate::store::Storage::F32,
+                Algorithm::Dcfr, iso, "50");
+            let plan = GpuPlan::build(&solver.spot, iso);
+            let full = training_terminal_spans(plan.fold_nodes.len(),
+                plan.show_nodes.len(), i32::MAX as u32).unwrap();
+            let mut terminal_slots = std::collections::BTreeSet::new();
+            for (nodes, spans, whole) in [
+                (&plan.fold_nodes, &plan.fold_spans, full[0]),
+                (&plan.show_nodes, &plan.show_spans, full[1]),
+            ] {
+                assert!(spans.iter().filter(|sp| sp.count > 0).count() > 1,
+                    "fixture needs terminals at multiple levels");
+                let per_level: Vec<u32> = spans.iter().flat_map(|sp| {
+                    let start = sp.start as usize;
+                    nodes[start..start + sp.count as usize].iter().copied()
+                }).collect();
+                assert_eq!(&per_level, nodes);
+                assert_eq!(whole.start, 0);
+                assert_eq!(whole.count as usize, nodes.len());
+                for &node in nodes {
+                    assert!(terminal_slots.insert(plan.cfv_slot[node as usize]),
+                        "terminal CFV rows must be unique");
+                }
+            }
+            for &node in plan.action_nodes.iter().chain(&plan.chance_nodes) {
+                assert!(!terminal_slots.contains(&plan.cfv_slot[node as usize]),
+                    "terminal CFV rows must not alias upward scratch");
+            }
+            let largest = plan.fold_nodes.len().max(plan.show_nodes.len());
+            assert!(largest > 0);
+            assert!(training_terminal_spans(plan.fold_nodes.len(),
+                plan.show_nodes.len(), largest as u32).is_some());
+            assert!(training_terminal_spans(plan.fold_nodes.len(),
+                plan.show_nodes.len(), (largest - 1) as u32).is_none());
+        }
+        for (fold, show) in [(0, 0), (0, 3), (3, 0)] {
+            let spans = training_terminal_spans(fold, show, 3).unwrap();
+            assert_eq!((spans[0].start, spans[0].count), (0, fold as u32));
+            assert_eq!((spans[1].start, spans[1].count), (0, show as u32));
+        }
+        assert!(training_terminal_spans(0, 0, 0).is_none());
+        assert!(training_terminal_spans(1, 1, 0).is_none());
+        assert!(training_terminal_spans(4, 1, 3).is_none());
+        assert!(training_terminal_spans(1, 4, 3).is_none());
+        assert!(training_terminal_spans(i32::MAX as usize, 0, u32::MAX).is_some());
+        assert!(training_terminal_spans(i32::MAX as usize + 1, 0, u32::MAX).is_none());
+        assert!(training_terminal_spans(0, usize::MAX, u32::MAX).is_none());
+    }
