+// Both terminal kinds consolidate together or retain their original level schedule.
+fn training_terminal_spans(
+    fold_len: usize, show_len: usize, grid_limit: u32,
+) -> Option<[LevelSpan; 2]> {
+    if grid_limit == 0 { return None; }
+    let full = |len: usize| {
+        let count = i32::try_from(len).ok()? as u32;
+        (count <= grid_limit).then_some(LevelSpan { start: 0, count })
+    };
+    Some([full(fold_len)?, full(show_len)?])
+}
