+    fn assert_raw_stores_equal(a: &Solver, b: &Solver) {
+        for (left, right) in a.regrets.iter().chain(&a.strat).zip(b.regrets.iter().chain(&b.strat)) {
+            match (left, right) {
+                (Store::I16 { q: lq, scale: ls }, Store::I16 { q: rq, scale: rs }) => {
