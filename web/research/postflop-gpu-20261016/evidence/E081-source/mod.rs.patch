+    #[test]
+    fn packed_action_launch_covers_every_node_and_tail() {
+        for n in [0u32, 1, 2, 3, 4, 5, 7, 8, 9, 127, 128, 129, 1_346_813, u32::MAX] {
+            let cfg = GpuSolver::action_cfg(n);
