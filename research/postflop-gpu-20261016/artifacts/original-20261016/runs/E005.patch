+    #[test]
+    fn two_action_partition_preserves_levels_membership_and_stable_order() {
+        let mut spans = Vec::new();
+        let mut total = 0;
+        for count in [0, MIN_TWO_ACTION_SPAN - 1, MIN_TWO_ACTION_SPAN, MIN_TWO_ACTION_SPAN + 1] {
+            spans.push(LevelSpan { start: total, count });
+            total += count;
+        }
+        let original: Vec<u32> = (0..total).collect();
+        let mut nodes = original.clone();
+        // Include arbitrary-menu fallback nodes alongside common action counts.
+        let action_count = |node: u32| [1, 2, 3, 4, 5, 11][node as usize % 6];
+        let prefixes = partition_two_action_spans(&mut nodes, &spans, |node| action_count(node) == 2);
+        assert_eq!(prefixes.len(), spans.len());
+        for (span, prefix) in spans.iter().zip(prefixes) {
+            assert_eq!(prefix.start, span.start);
+            let begin = span.start as usize;
+            let end = (span.start + span.count) as usize;
+            let level = &nodes[begin..end];
+            let mut membership = level.to_vec();
+            membership.sort_unstable();
+            assert_eq!(membership.as_slice(), &original[begin..end],
+                "partition cannot move nodes between levels");
+            if span.count < MIN_TWO_ACTION_SPAN {
+                assert_eq!(prefix.count, 0);
+                assert_eq!(level, &original[begin..end], "small levels retain their launch order");
+            } else {
+                let (two, rest) = level.split_at(prefix.count as usize);
+                assert!(!two.is_empty() && !rest.is_empty());
+                assert!(two.iter().all(|&node| action_count(node) == 2));
+                assert!(rest.iter().all(|&node| action_count(node) != 2));
+                assert!(two.windows(2).chain(rest.windows(2)).all(|w| w[0] < w[1]),
+                    "each bin must preserve the original node order");
+            }
+        }
+    }
