+const MIN_TWO_ACTION_SPAN: u32 = 4096;
+
+// Only reorder independent nodes within a level. Keep the aggregate spans
+// intact for down/evaluation sweeps, with a two-action prefix for training up.
+fn partition_two_action_spans(
+    nodes: &mut [u32], spans: &[LevelSpan], has_two_actions: impl Fn(u32) -> bool,
+) -> Vec<LevelSpan> {
+    let mut prefixes = Vec::with_capacity(spans.len());
+    let mut scratch = Vec::new();
+    for &span in spans {
+        let mut prefix = LevelSpan { start: span.start, count: 0 };
+        if span.count >= MIN_TWO_ACTION_SPAN {
+            let level = &mut nodes[span.start as usize..(span.start + span.count) as usize];
+            scratch.clear();
+            scratch.extend(level.iter().copied().filter(|&node| has_two_actions(node)));
+            prefix.count = scratch.len() as u32;
+            if prefix.count > 0 && prefix.count < span.count {
+                scratch.extend(level.iter().copied().filter(|&node| !has_two_actions(node)));
+                level.copy_from_slice(&scratch);
+            }
+        }
+        prefixes.push(prefix);
+    }
+    prefixes
+}
