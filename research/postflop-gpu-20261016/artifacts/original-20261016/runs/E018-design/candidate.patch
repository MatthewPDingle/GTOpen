+fn action_child_cfv_slots(spot: &Spot, actions: &[u32], cfv_slot: &[u32], cfv_blocks: usize) -> Vec<u32> {
+    let mut slots = vec![SENTINEL; spot.tree.children.len()];
+    for &id in actions {
+        let node = &spot.tree.nodes[id as usize];
+        assert_eq!(node.kind, KIND_ACTION);
+        let start = node.children_start as usize;
+        let end = start.checked_add(node.num_children as usize).expect("action child span overflow");
+        let children = spot.tree.children.get(start..end).expect("invalid action child span");
+        for (a, &child) in children.iter().enumerate() {
+            let &slot = cfv_slot.get(child as usize).expect("invalid visited action child");
+            assert!(slot != SENTINEL && (slot as usize) < cfv_blocks,
+                "visited action child has no valid physical CFV slot");
+            slots[start + a] = slot;
+        }
+    }
+    slots
+}
