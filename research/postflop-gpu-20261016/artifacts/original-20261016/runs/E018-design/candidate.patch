+    fn assert_child_mapping(spot: &Spot, plan: &GpuPlan) {
+        assert_eq!(plan.child_cfv_slots.len(), spot.tree.children.len());
+        let mut consumed = vec![false; spot.tree.children.len()];
+        for &id in &plan.action_nodes {
+            let node = &spot.tree.nodes[id as usize];
+            for a in 0..node.num_children as usize {
+                let edge = node.children_start as usize + a;
+                assert!(!consumed[edge], "action edges must retain distinct child indices");
+                consumed[edge] = true;
+                let child = spot.tree.children[edge];
+                assert_ne!(child, SENTINEL);
+                let slot = plan.child_cfv_slots[edge];
+                assert!((slot as usize) < plan.cfv_blocks);
+                assert_eq!(slot, plan.cfv_slot[child as usize], "physical address must match original lookup");
+            }
+        }
+        for (edge, &used) in consumed.iter().enumerate() {
+            if !used { assert_eq!(plan.child_cfv_slots[edge], SENTINEL); }
+            if spot.tree.children[edge] == SENTINEL {
+                assert!(!used, "chance sentinels must not be read as action children");
+            }
+        }
+        assert_eq!(plan.training_metadata_bytes(), spot.tree.children.len() as u64 * 4);
+        let original_staging = (plan.reach_blocks[0] * plan.nh[0]
+            + plan.reach_blocks[1] * plan.nh[1] + plan.cfv_blocks * plan.nh_max) as u64 * 4;
+        assert_eq!(plan.staging_bytes(), original_staging + plan.training_metadata_bytes());
+    }
