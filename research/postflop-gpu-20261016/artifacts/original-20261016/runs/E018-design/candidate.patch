+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{parse_sizes, Solver, SpotConfig, StreetSizing};
+    use std::sync::Arc;
+
+    #[test]
+    fn child_mapping_matches_observed_metadata_for_turn_and_river() {
+        for board in ["KsQs2dJd", "KsQs2dJd3c"] {
+            let sizing = || StreetSizing { bet: parse_sizes("50").unwrap(), raise: vec![], donk: vec![] };
+            let spot = Arc::new(Spot::new(SpotConfig {
+                board: board.into(), range_oop: "AA,KK,QQ,AKs,AKo".into(),
+                range_ip: "AA,QQ,TT,AQs,AQo".into(),
+                tree: TreeConfig { starting_pot: 10.0, effective_stack: 20.0,
+                    oop: [sizing(), sizing(), sizing()], ip: [sizing(), sizing(), sizing()],
+                    ..Default::default() },
+            }).unwrap());
+            let mut solver = Solver::new(spot.clone());
+            solver.use_isomorphism = false;
+            let mut plan = GpuPlan::build(&spot, false);
+            plan.use_full_action_arenas(&spot);
+            let expected = metadata(&plan, &spot);
+            let gpu = GpuSolver::new(&solver).expect("test requires CUDA");
+            assert_eq!(gpu.d_child_cfv_slots.len(), spot.tree.children.len());
+            assert_eq!(gpu.stream.clone_dtoh(&gpu.d_child_cfv_slots).unwrap(), plan.child_cfv_slots);
+            assert_eq!(observed_metadata(&gpu), expected);
+            let capacity = stored_capacity_plan(&spot);
+            assert_eq!(capacity["base_gpu_metadata_bytes"].as_u64().unwrap(), expected);
+            let added = plan.training_metadata_bytes();
+            plan.child_cfv_slots.clear();
+            assert_eq!(expected - metadata(&plan, &spot), added,
+                "new immutable payload must be counted exactly once");
+        }
+    }
+}
