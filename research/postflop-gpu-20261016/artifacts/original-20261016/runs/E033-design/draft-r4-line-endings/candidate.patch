+    #[test]
+    fn persisting_l2_cleanup_ownership_and_errors() {
+        let mut host=reach_reuse_solver(crate::store::Storage::F32,Algorithm::CfrPlus,false,"50");
+        let mut a=GpuSolver::new(&host).unwrap(); let mut peer=GpuSolver::new(&host).unwrap();
+        assert!(a.uses_persisting_l2() && peer.uses_persisting_l2());
+        let ctx=a._ctx.clone(); let stream=a.stream.clone();
+        let peer_window=cache_policy::window(&peer.stream).unwrap();
+        let limit=ctx.get_limit(sys::CUlimit::CU_LIMIT_PERSISTING_L2_CACHE_SIZE).unwrap();
+        a.iterate().unwrap(); peer.iterate().unwrap();
+        a.cache_policy.as_mut().unwrap().fail_before_cleanup=true;
+        assert!(a.sync_to_cpu(&mut host).is_err());
+        assert!(a.cache_faulted && !a.cache_policy.as_ref().unwrap().clean());
+        assert!(a.iterate().is_err());
+        a.cache_policy.as_mut().unwrap().fail_before_cleanup=false;
+        a.sync_to_cpu(&mut host).unwrap(); assert!(!a.cache_faulted && a.cache_policy.as_ref().unwrap().clean());
+        assert_eq!(cache_policy::window(&peer.stream).unwrap(),peer_window);
+        // Raw abort exits capture without instantiating a partial executable.
+        a.begin_cache_epoch().unwrap();
+        a.stream.begin_capture(sys::CUstreamCaptureMode::CU_STREAM_CAPTURE_MODE_THREAD_LOCAL).unwrap();
+        assert_eq!(a.abort_cache_capture("injected queue failure".into()),"injected queue failure");
+        assert_eq!(a.stream.capture_status().unwrap(),sys::CUstreamCaptureStatus::CU_STREAM_CAPTURE_STATUS_NONE);
+        a.sync_to_cpu(&mut host).unwrap();
+        // The setter succeeds but verification fails: uncertainty cannot be
+        // bypassed by the next begin, and explicit cleanup restores eligibility.
+        a.cache_policy.as_mut().unwrap().fail_after_set=true;
+        assert!(a.begin_cache_epoch().is_err());
+        assert!(a.cache_faulted && !a.cache_policy.as_ref().unwrap().clean());
+        assert!(a.begin_cache_epoch().is_err());
+        a.cache_policy.as_mut().unwrap().fail_after_set=false;
+        a.sync_to_cpu(&mut host).unwrap();
+        assert!(a.cache_policy.as_ref().unwrap().clean() && !a.cache_faulted);
+        a.begin_cache_epoch().unwrap(); a.sync_to_cpu(&mut host).unwrap();
+        // Exercise the same production cleaner on guarded finite-width words.
+        // Full readback includes the last unhinted word and both sentinel ends.
+        let words:Vec<u32>=(0..97).map(|i|0x7fc12345u32.wrapping_add(i*7919)).collect();
+        let data=stream.clone_htod(&words).unwrap();
+        let (major,minor)=ctx.compute_capability().unwrap();
+        let arch:&'static str=Box::leak(format!("compute_{major}{minor}").into_boxed_str());
+        let mut policy=cache_policy::CachePolicy::prepare(&ctx,&stream,&data,arch,major).unwrap().unwrap();
+        assert_eq!(policy.bytes(),384);
+        for _ in 0..2 {
+            policy.begin(&stream).unwrap(); policy.finish(&stream).unwrap();
+            assert!(policy.clean()); assert_eq!(stream.clone_dtoh(&data).unwrap(),words);
+        }
+        drop(policy); drop(data);
+        // A dirty Drop runs before its metadata allocation is freed.
+        a.iterate().unwrap(); drop(a);
+        assert_eq!(cache_policy::window(&stream).unwrap().num_bytes,0); ctx.check_err().unwrap();
+        assert_eq!(cache_policy::window(&peer.stream).unwrap(),peer_window);
+        assert_eq!(ctx.get_limit(sys::CUlimit::CU_LIMIT_PERSISTING_L2_CACHE_SIZE).unwrap(),limit);
+        peer.iterate().unwrap(); peer.sync_to_cpu(&mut host).unwrap(); peer.close().unwrap();
+    }
