+                    assert_eq!(a.as_slice(),b.as_slice()); assert_eq!(bits(sa.as_slice()),bits(sb.as_slice()));
+                },
+                (Store::U16{q:a,scale:sa}, Store::U16{q:b,scale:sb}) => {
