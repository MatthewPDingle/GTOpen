+// One pointer coordinate system for every level. Uniform plans borrow the
+// aggregate list without allocating a second device buffer. A mixed plan
+// uses a separate stable actor0-only list for ALL filtered spans.
+fn actor0_down_worklist(
+    nodes: &[u32], spans: &[LevelSpan], players: &[i32],
+) -> (Vec<u32>, Vec<LevelSpan>) {
+    let mut actor0_count = 0usize;
+    let mut mixed = false;
+    for sp in spans {
+        let level = &nodes[sp.start as usize..(sp.start + sp.count) as usize];
+        let count = level.iter().filter(|&&n| players[n as usize] == 0).count();
+        actor0_count += count;
+        mixed |= count != 0 && count != level.len();
     }
+    let mut filtered = if mixed { Vec::with_capacity(actor0_count) } else { Vec::new() };
+    let mut result = Vec::with_capacity(spans.len());
+    for sp in spans {
+        let level = &nodes[sp.start as usize..(sp.start + sp.count) as usize];
+        if mixed {
+            let start = filtered.len() as u32;
+            filtered.extend(level.iter().copied().filter(|&n| players[n as usize] == 0));
+            result.push(LevelSpan { start, count: filtered.len() as u32 - start });
+        } else {
+            let count = if level.first().is_some_and(|&n| players[n as usize] == 0) {
+                sp.count
+            } else { 0 };
+            result.push(LevelSpan { start: sp.start, count });
+        }
+    }
+    (filtered, result)
 }
 
