+fn scatter_quantized(store: &Store, blocks: &[Block], words: &[u16], scales: &[f32]) {
+    blocks.par_iter().enumerate().for_each(|(index, block)| {
+        let start = block.output as usize;
+        let values = &words[start..start + block.len as usize];
+        // Descriptor host ranges and node indices are disjoint, like write_arena.
+        unsafe {
+            match store {
+                Store::I16 { q, scale } => {
+                    for (dst, &value) in q.slice(block.host, values.len()).iter_mut().zip(values) {
+                        *dst = value as i16;
+                    }
+                    scale.write_at(block.node as usize, scales[index]);
+                }
+                Store::U16 { q, scale } => {
+                    q.slice(block.host, values.len()).copy_from_slice(values);
+                    scale.write_at(block.node as usize, scales[index]);
+                }
+                Store::F32(_) => unreachable!("quantized readback requires compressed stores"),
+            }
+        }
+    });
+}
