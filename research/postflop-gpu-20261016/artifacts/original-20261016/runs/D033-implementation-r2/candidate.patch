+fn batch_native(gpu:&mut GpuSolver) -> DiagResult<Value> {
+    let start=gpu._ctx.new_event(Some(sys::CUevent_flags::CU_EVENT_DEFAULT)).map_err(e)?;
+    let end=gpu._ctx.new_event(Some(sys::CUevent_flags::CU_EVENT_DEFAULT)).map_err(e)?;
+    let wall=Instant::now();
+    start.record(&gpu.stream).map_err(e)?;
+    for _ in 0..20 { gpu.iterate()?; }
+    end.record(&gpu.stream).map_err(e)?;
+    gpu.synchronize()?;
+    let wall_ms=wall.elapsed().as_secs_f64()*1000.;
+    let ms=start.elapsed_ms(&end).map_err(e)?;
+    if !ms.is_finite() || ms<0. { return Err("invalid native batch interval".into()); }
+    Ok(json!({"arm":"native","end_iteration":gpu.iteration,"iterations":20,"device_batch_ms":ms,"host_batch_ms":wall_ms}))
+}
+
+fn batch_instrumented(arm:&mut Instrumented<'_>) -> DiagResult<Value> {
+    let start=arm.gpu._ctx.new_event(Some(sys::CUevent_flags::CU_EVENT_DEFAULT)).map_err(e)?;
+    let end=arm.gpu._ctx.new_event(Some(sys::CUevent_flags::CU_EVENT_DEFAULT)).map_err(e)?;
+    let wall=Instant::now();
+    start.record(&arm.gpu.stream).map_err(e)?;
+    for _ in 0..20 { arm.iterate()?; }
+    end.record(&arm.gpu.stream).map_err(e)?;
+    arm.gpu.synchronize()?;
+    let wall_ms=wall.elapsed().as_secs_f64()*1000.;
+    let ms=start.elapsed_ms(&end).map_err(e)?;
+    let gap=arm.graphs[0].events.last().unwrap().elapsed_ms(&arm.graphs[1].events[0]).map_err(e)?;
+    if !ms.is_finite() || ms<0. || !gap.is_finite() || gap<0. { return Err("invalid instrumented interval".into()); }
+    let samples=arm.graphs.iter().enumerate().map(|(i,g)|g.sample(i,arm.gpu.iteration)).collect::<DiagResult<Vec<_>>>()?;
+    Ok(json!({"arm":"instrumented","end_iteration":arm.gpu.iteration,"iterations":20,
+        "device_batch_ms":ms,"host_batch_ms":wall_ms,"final_replay_inter_graph_gap_ms":gap,
+        "final_replay_only":samples,"setup_upload_wait_excluded":true}))
+}
