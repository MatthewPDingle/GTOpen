+#[test]
+#[ignore = "manual D033 captured-graph device event diagnostic; serialized GPU execution only"]
+fn captured_graph_device_event_diagnostic() {
+    if let Err(error)=diagnostic() {
+        let _=emit(json!({"stage":"invalid","error":error}));
+        panic!("D033 invalid diagnostic: {error}");
+    }
+}
