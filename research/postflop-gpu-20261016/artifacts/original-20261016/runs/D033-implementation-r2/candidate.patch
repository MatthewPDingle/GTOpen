+#[derive(Clone, Debug, PartialEq, Eq)]
+struct KernelDescription { function: usize, name: String, grid: [u32; 3], block: [u32; 3], shared: u32 }
+
+impl KernelDescription {
+    fn logical(&self) -> Value {
+        json!({"kernel": self.name, "grid": self.grid, "block": self.block, "shared_bytes": self.shared})
+    }
+}
+
+fn describe_kernel(node: sys::CUgraphNode) -> DiagResult<KernelDescription> {
+    let mut kind = sys::CUgraphNodeType::CU_GRAPH_NODE_TYPE_KERNEL;
+    unsafe { cu(sys::cuGraphNodeGetType(node, &mut kind))?; }
+    if kind != sys::CUgraphNodeType::CU_GRAPH_NODE_TYPE_KERNEL {
+        return Err(format!("unexpected non-kernel graph node: {kind:?}"));
+    }
+    let mut params: sys::CUDA_KERNEL_NODE_PARAMS = unsafe { std::mem::zeroed() };
+    unsafe { cu(sys::cuGraphKernelNodeGetParams_v2(node, &mut params))?; }
+    let mut name = ptr::null();
+    unsafe { cu(sys::cuFuncGetName(&mut name, params.func))?; }
+    if name.is_null() { return Err("null kernel name".into()); }
+    let name = unsafe { CStr::from_ptr(name) }.to_str().map_err(e)?.to_owned();
+    if !KERNEL_NAMES.contains(&name.as_str()) { return Err(format!("unexpected training kernel {name}")); }
+    // Do not compare kernelParams pointer identity or struct padding across clones.
+    Ok(KernelDescription { function: params.func as usize, name,
+        grid: [params.gridDimX, params.gridDimY, params.gridDimZ],
+        block: [params.blockDimX, params.blockDimY, params.blockDimZ], shared: params.sharedMemBytes })
+}
+
+fn graph_nodes(graph: sys::CUgraph) -> DiagResult<Vec<sys::CUgraphNode>> {
+    let mut n = 0;
+    unsafe { cu(sys::cuGraphGetNodes(graph, ptr::null_mut(), &mut n))?; }
+    let mut nodes = vec![ptr::null_mut(); n];
+    unsafe { cu(sys::cuGraphGetNodes(graph, nodes.as_mut_ptr(), &mut n))?; }
+    if n != nodes.len() || nodes.iter().any(|n| n.is_null()) { return Err("graph node enumeration changed".into()); }
+    Ok(nodes)
+}
+
+fn graph_edges(graph: sys::CUgraph) -> DiagResult<Vec<(usize, usize)>> {
+    let mut n = 0;
+    unsafe { cu(sys::cuGraphGetEdges_v2(graph, ptr::null_mut(), ptr::null_mut(), ptr::null_mut(), &mut n))?; }
+    let mut from = vec![ptr::null_mut(); n];
+    let mut to = vec![ptr::null_mut(); n];
+    let mut data: Vec<sys::CUgraphEdgeData> = (0..n).map(|_| unsafe { std::mem::zeroed() }).collect();
+    unsafe { cu(sys::cuGraphGetEdges_v2(graph, from.as_mut_ptr(), to.as_mut_ptr(), data.as_mut_ptr(), &mut n))?; }
+    if n != data.len() || data.iter().any(|d| d.from_port != 0 || d.to_port != 0 || d.type_ != 0) {
+        return Err("changed edge count or nondefault graph dependency".into());
+    }
+    Ok(from.into_iter().zip(to).map(|(a, b)| (a as usize, b as usize)).collect())
+}
+
+fn chain(graph: sys::CUgraph) -> DiagResult<Vec<sys::CUgraphNode>> {
+    let nodes = graph_nodes(graph)?;
+    let edges = graph_edges(graph)?;
+    if nodes.is_empty() || edges.len() != nodes.len() - 1 { return Err("graph is not a nonempty chain".into()); }
+    let ids: HashSet<_> = nodes.iter().map(|&n| n as usize).collect();
+    let mut next = HashMap::new();
+    let mut incoming = HashSet::new();
+    for &(a, b) in &edges {
+        if !ids.contains(&a) || !ids.contains(&b) || next.insert(a, b).is_some() || !incoming.insert(b) {
+            return Err("graph has unknown endpoints or branching dependencies".into());
+        }
+    }
+    let roots: Vec<_> = ids.difference(&incoming).copied().collect();
+    if roots.len() != 1 { return Err("graph needs exactly one root".into()); }
+    let mut order = Vec::with_capacity(nodes.len());
+    let mut seen = HashSet::new();
+    let mut id = roots[0];
+    loop {
+        if !seen.insert(id) { return Err("graph cycle".into()); }
+        order.push(id as sys::CUgraphNode);
+        if let Some(&child) = next.get(&id) { id = child; } else { break; }
+    }
+    if order.len() != nodes.len() { return Err("graph chain omits nodes".into()); }
+    for &node in &order { describe_kernel(node)?; }
+    Ok(order)
+}
+
+struct TimedGraph {
+    ctx: Arc<CudaContext>, stream: Arc<CudaStream>, graph: sys::CUgraph, exec: sys::CUgraphExec,
+    events: Vec<CudaEvent>, descriptions: Vec<KernelDescription>, topology: Value,
+}
+
+impl TimedGraph {
+    fn close(&mut self) -> DiagResult<()> {
+        if self.graph.is_null() && self.exec.is_null() { return Ok(()); }
+        let mut errors = Vec::new();
+        if let Err(err) = self.ctx.bind_to_thread() { errors.push(format!("bind: {err:?}")); }
+        if let Err(err) = self.stream.synchronize() { errors.push(format!("wait: {err:?}")); }
+        unsafe {
+            if !self.exec.is_null() {
+                if let Err(err) = cu(sys::cuGraphExecDestroy(self.exec)) { errors.push(err); }
+                self.exec = ptr::null_mut();
+            }
+            if !self.graph.is_null() {
+                if let Err(err) = cu(sys::cuGraphDestroy(self.graph)) { errors.push(err); }
+                self.graph = ptr::null_mut();
+            }
+        }
+        // These handles outlive both graph destroy attempts; no borrowed source is destroyed.
+        self.events.clear();
+        if let Err(err)=self.ctx.check_err() { errors.push(format!("event/context cleanup: {err:?}")); }
+        if errors.is_empty() { Ok(()) } else { Err(errors.join("; ")) }
+    }
+
+    fn new(gpu: &GpuSolver, source: &CudaGraph, graph_index: usize) -> DiagResult<Self> {
+        gpu._ctx.bind_to_thread().map_err(e)?;
+        let original = chain(source.cu_graph())?;
+        let descriptions = original.iter().map(|&n| describe_kernel(n)).collect::<DiagResult<Vec<_>>>()?;
+        let mut result = Self { ctx: gpu._ctx.clone(), stream: gpu.stream.clone(),
+            graph: ptr::null_mut(), exec: ptr::null_mut(), events: vec![], descriptions, topology: Value::Null };
+        unsafe { cu(sys::cuGraphClone(&mut result.graph, source.cu_graph()))?; }
+        let mut mapped = Vec::new();
+        for (i, &node) in original.iter().enumerate() {
+            let mut clone = ptr::null_mut();
+            unsafe { cu(sys::cuGraphNodeFindInClone(&mut clone, node, result.graph))?; }
+            if clone.is_null() || describe_kernel(clone)? != result.descriptions[i] {
+                return Err("cloned kernel descriptor changed".into());
+            }
+            mapped.push(clone);
+        }
+        if chain(result.graph)? != mapped { return Err("clone changed original ordering".into()); }
+        let mut expected: HashSet<_> = graph_edges(result.graph)?.into_iter().collect();
+        let mut event_nodes = Vec::new();
+        for i in 0..=mapped.len() {
+            result.events.push(gpu._ctx.new_event(Some(sys::CUevent_flags::CU_EVENT_DEFAULT)).map_err(e)?);
+            let mut event_node = ptr::null_mut();
+            let (deps, count) = if i == 0 { (ptr::null(), 0) } else { (&mapped[i - 1] as *const _, 1) };
+            unsafe { cu(sys::cuGraphAddEventRecordNode(&mut event_node, result.graph, deps, count,
+                result.events[i].cu_event()))?; }
+            if i > 0 { expected.insert((mapped[i - 1] as usize, event_node as usize)); }
+            if i < mapped.len() {
+                unsafe { cu(sys::cuGraphAddDependencies(result.graph, &event_node, &mapped[i], 1))?; }
+                expected.insert((event_node as usize, mapped[i] as usize));
+            }
+            event_nodes.push(event_node);
+        }
+        let edges = graph_edges(result.graph)?;
+        if graph_nodes(result.graph)?.len() != mapped.len() * 2 + 1 || edges.len() != expected.len()
+            || edges.iter().copied().collect::<HashSet<_>>() != expected {
+            return Err("instrumented graph topology differs from registered boundaries".into());
+        }
+        for (i, &node) in mapped.iter().enumerate() {
+            if describe_kernel(node)? != result.descriptions[i] || describe_kernel(original[i])? != result.descriptions[i] {
+                return Err("event insertion modified an original kernel".into());
+            }
+        }
+        if chain(source.cu_graph())? != original { return Err("source graph changed".into()); }
+        let stable_edges: Vec<_> = (0..mapped.len() - 1).map(|i| json!([format!("K{i}"), format!("K{}", i+1)])).collect();
+        let boundaries: Vec<_> = (0..mapped.len()).flat_map(|i|
+            [json!([format!("E{i}"), format!("K{i}")]), json!([format!("K{i}"), format!("E{}", i+1)])]).collect();
+        result.topology = json!({"graph": graph_index, "original_kernel_nodes": mapped.len(),
+            "event_nodes": result.events.len(), "original_edges": stable_edges, "added_edges": boundaries,
+            "kernel_descriptors": result.descriptions.iter().enumerate().map(|(i,d)| json!({
+                "ordinal":i,"logical":d.logical(),"run_local_function":format!("0x{:x}",d.function)
+            })).collect::<Vec<_>>(), "kernel_argument_setter_calls":0,
+            "argument_preservation":"CUDA graph clone; no parameter dereference or setter"});
+        unsafe { cu(sys::cuGraphInstantiateWithFlags(&mut result.exec, result.graph,
+            sys::CUgraphInstantiate_flags::CUDA_GRAPH_INSTANTIATE_FLAG_AUTO_FREE_ON_LAUNCH as u64))?; }
+        Ok(result)
+    }
+
+    fn upload(&self) -> DiagResult<()> {
+        self.ctx.bind_to_thread().map_err(e)?;
+        unsafe { cu(sys::cuGraphUpload(self.exec, self.stream.cu_stream())) }
+    }
+
+    fn launch(&self) -> DiagResult<()> {
+        self.ctx.bind_to_thread().map_err(e)?;
+        unsafe { cu(sys::cuGraphLaunch(self.exec, self.stream.cu_stream())) }
+    }
+
+    fn sample(&self, graph: usize, iteration: u32) -> DiagResult<Value> {
+        // Caller has completed the whole batch. No host wait occurs between kernels/replays.
+        let mut nodes = Vec::new();
+        let mut families = BTreeMap::<String, f64>::new();
+        for (i, desc) in self.descriptions.iter().enumerate() {
+            let ms = self.events[i].elapsed_ms(&self.events[i+1]).map_err(e)?;
+            if !ms.is_finite() || ms < 0.0 { return Err("invalid device interval".into()); }
+            *families.entry(desc.name.clone()).or_default() += ms as f64;
+            nodes.push(json!({"ordinal":i,"kernel":desc.name,"ms":ms,"near_resolution":ms<=0.0005}));
+        }
+        let envelope = self.events[0].elapsed_ms(self.events.last().unwrap()).map_err(e)?;
+        if !envelope.is_finite() || envelope < 0.0 { return Err("invalid graph envelope".into()); }
+        Ok(json!({"graph":graph,"iteration":iteration,"scope":"final replay only; event-perturbed intervals",
+            "nodes":nodes,"family_ms":families,"graph_envelope_ms":envelope}))
+    }
+}
+
+impl Drop for TimedGraph {
+    fn drop(&mut self) {
+        // Context/stream Arcs and the enclosing solver borrow keep all references alive.
+        if let Err(error) = self.close() {
+            let _ = writeln!(io::stderr().lock(), "D033_CLEANUP_ERROR {error}");
+        }
+    }
+}
+
+struct Instrumented<'a> { gpu: &'a mut GpuSolver, graphs: Vec<TimedGraph> }
+impl<'a> Instrumented<'a> {
+    fn new(gpu: &'a mut GpuSolver) -> DiagResult<Self> {
+        let source = gpu.graphs.as_ref().ok_or("native graphs not captured")?;
+        let graphs = vec![TimedGraph::new(gpu, &source[0], 0)?, TimedGraph::new(gpu, &source[1], 1)?];
+        for graph in &graphs { graph.upload()?; emit(json!({"stage":"graph","topology":graph.topology}))?; }
+        gpu.synchronize()?;
+        Ok(Self { gpu, graphs })
+    }
+
+    fn iterate(&mut self) -> DiagResult<()> {
+        self.gpu.iteration += 1;
+        let disc = Discounts::for_iteration(self.gpu.algo, self.gpu.iteration);
+        self.gpu.stream
+            .memcpy_htod(&[disc.pos, disc.neg, disc.strat], &mut self.gpu.d_disc)
+            .map_err(e)?;
+        for graph in &self.graphs { graph.launch()?; }
+        Ok(())
+    }
+
+    fn close(&mut self) -> DiagResult<()> {
+        let errors: Vec<_> = self.graphs.iter_mut().filter_map(|graph|graph.close().err()).collect();
+        if errors.is_empty() { Ok(()) } else { Err(errors.join("; ")) }
+    }
+}
