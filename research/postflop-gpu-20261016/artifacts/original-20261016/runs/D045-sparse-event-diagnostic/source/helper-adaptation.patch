+// Fixed D035 metadata-only selectors, rebound to accepted E020 shared-memory sizes.
+const SELECTED: [(usize, &str); 3] = [(19, "down_action"), (29, "up_show"), (34, "up_action")];
+const EVENT_BOUNDARIES: [usize; 6] = [19, 20, 29, 30, 34, 35];
