+fn validate_selected(descriptions: &[KernelDescription], graph: usize) -> DiagResult<()> {
+    if graph >= 2 || descriptions.len() != 63 {
+        return Err("registered graph index or kernel count differs".into());
+    }
+    for &(ordinal, family) in &SELECTED {
+        let desc = &descriptions[ordinal];
+        let expected_shared = if family == "up_show" { [6300, 5060][graph] } else { 0 };
+        if desc.name != family || desc.grid != [141120, 1, 1]
+            || desc.block != [128, 1, 1] || desc.shared != expected_shared {
+            return Err(format!("graph{graph} registered selector{ordinal} descriptor differs"));
+        }
+        // Largest CTA count, first ordinal on ties; never select from observed timings.
+        let mut selected = None;
+        let mut largest = 0u128;
+        for (i, candidate) in descriptions.iter().enumerate() {
+            if candidate.name == family {
+                let count = candidate.grid.iter().fold(1u128, |a, &b| a * b as u128);
+                if selected.is_none() || count > largest {
+                    selected = Some(i);
+                    largest = count;
+                }
+            }
+        }
+        if selected != Some(ordinal) {
+            return Err(format!("graph{graph} registered metadata selector differs for {family}"));
+        }
+    }
+    Ok(())
+}
 
