+def embedded_cuda(binary,name):
+    data=Path(binary).read_bytes()
+    counts={role:data.count((HERE/f'{role}-kernels.cu').read_bytes()) for role in ['E015','E020']}
+    if name=='E015-resource':
+        assert all(n>0 for n in counts.values()),('resource must embed both exact CUDA sources',counts)
+    else:
+        role=name.split('-')[0];other='E020' if role=='E015' else 'E015'
+        assert counts[role]>0 and counts[other]==0,('wrong embedded CUDA arm',name,counts)
+    return counts
+
+def check_cargo_artifacts(logs,workspace,target,wanted):
+    artifacts=[x for x in logs if x.get('reason')=='compiler-artifact']
+    target=target.resolve();workspace=workspace.resolve()
+    assert artifacts
+    for item in artifacts:
+        for filename in item.get('filenames',[])+([item['executable']] if item.get('executable') else []):
+            assert Path(filename).resolve().is_relative_to(target),('artifact outside arm target',filename,target)
+    solver=[x for x in artifacts if x['target']['name']=='solver' and x['target']['kind']==['lib']]
+    assert len(solver)==1
+    rows=[x for x in artifacts if x.get('executable') and x.get('profile',{}).get('test') and x['target']['name'] in wanted]
+    assert {x['target']['name'] for x in rows}==set(wanted) and len(rows)==len(wanted)
+    for item in solver+rows:
+        assert item['fresh'] is False,('refuse cached arm solver/test artifact',item['target']['name'])
+        assert Path(item['manifest_path']).resolve()==workspace/'crates/solver/Cargo.toml'
+        expected=workspace/'crates/solver/src/lib.rs' if item in solver else HERE/('resource.rs' if item['target']['name']=='postflop_wide_turn_resources' else 'evaluator.rs')
+        assert Path(item['target']['src_path']).resolve()==expected.resolve()
+    return rows,solver[0]
+
