 fn e(err: impl std::fmt::Debug) -> String {
     format!("cuda: {err:?}")
+}
+
+
+// Diagnostic-only constructor wall times: no CUDA events or extra waits.
+#[derive(serde::Serialize)]
+struct ConstructorSpan { stage: &'static str, wall_ms: f64 }
+struct ConstructorTrace {
+    started: Option<std::time::Instant>,
+    last: Option<std::time::Instant>,
+    spans: Vec<ConstructorSpan>,
+}
+impl ConstructorTrace {
+    fn new() -> Self {
+        let enabled = std::env::var_os("POSTFLOP_AUTORESEARCH_CONSTRUCTOR_PROFILE")
+            .as_deref() == Some(std::ffi::OsStr::new("1"));
+        let started = enabled.then(std::time::Instant::now);
+        Self { started, last: started, spans: Vec::with_capacity(if enabled { 16 } else { 0 }) }
+    }
+    fn mark(&mut self, stage: &'static str) {
+        if let Some(last) = self.last {
+            let now = std::time::Instant::now();
+            let wall_ms = now.duration_since(last).as_secs_f64() * 1e3;
+            if wall_ms.is_finite() { self.spans.push(ConstructorSpan { stage, wall_ms }); }
+            self.last = Some(now);
+        }
+    }
+    fn finish(self, quantized_readback: bool, arena_elements: [usize; 2], nodes: usize) {
+        if let Some(started) = self.started {
+            let wall_ms_before_logging = started.elapsed().as_secs_f64() * 1e3;
+            if !wall_ms_before_logging.is_finite() { return; }
+            use std::io::Write;
+            let mut stderr = std::io::stderr().lock();
+            let _ = writeln!(stderr, "GPU_CONSTRUCTOR_PROFILE {}", serde_json::json!({
+                "schema_version": 1, "phase": "gpu_new_with_budget", "completed": true,
+                "clock": "host_wall", "diagnostic_only": true,
+                "environment": {
+                    "POSTFLOP_AUTORESEARCH_CONSTRUCTOR_PROFILE": "1",
+                    "CUDA_MODULE_LOADING": std::env::var("CUDA_MODULE_LOADING").ok()
+                },
+                "quantized_readback": quantized_readback, "nodes": nodes,
+                "arena_elements": arena_elements,
+                "wall_ms_before_logging": wall_ms_before_logging, "spans": self.spans,
+                "extra_cuda_synchronizations": 0,
+                "note": "Host-call spans may block or submit asynchronous work. Only existing waits inside named spans drain the stream; these are not isolated device times. Logging/timers perturb initialization; exclude this run from qualification."
+            }));
+        }
+    }
 }
 
