+                if node.player != 1 || s.locks.contains_key(&n) { continue; }
+                let na = node.num_children as usize;
+                let off = plan.node_data_off[n as usize] as usize;
+                for i in 0..nh {
+                    let mut sum = 0.0f32;
+                    for a in 0..na {
+                        let r = old[off + a * nh + i];
+                        sum += if r > 0.0 { r } else { 0.0 };
+                    }
+                    for a in 0..na {
