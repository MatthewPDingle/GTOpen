+                let off = plan.node_data_off[n as usize] as usize;
+                for a in 0..node.num_children as usize {
+                    for i in 0..nh {
+                        seed[off + a * nh + i] = match i % 7 {
+                            0 => -1.0,
+                            1 => if a % 2 == 0 { -0.0 } else { 0.0 },
+                            2 => if a == 0 { f32::from_bits((127 - 41) << 23) } else { 0.0 },
