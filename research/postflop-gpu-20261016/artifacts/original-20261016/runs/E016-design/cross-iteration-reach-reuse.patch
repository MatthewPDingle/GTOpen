+    #[cfg(feature = "preflop-research")]
+    #[test]
+    fn paired_reach_reuse_continuation_invalidates_before_validation_and_changed_roots() {
+        let s = reach_reuse_solver(crate::store::Storage::F32, Algorithm::CfrPlus,
+            false, "25,75");
+        let mut candidate = reach_reuse_gpu(&s, false);
+        let mut reference = reach_reuse_gpu(&s, false);
+        // Validation failures must disable reuse before any upload, without
+        // modifying device arrays. No synthetic CUDA fault is injected.
+        for invalid in 0..3 {
+            candidate.iterate().unwrap();
+            legacy_iteration(&mut reference);
+            assert!(candidate.player0_reach_current);
+            let own = vec![1.0; candidate.nh[1] as usize];
+            let opponent = vec![1.0; candidate.nh[0] as usize];
+            let result = match invalid {
+                0 => candidate.research_continuation_sweep(2, 1, &own, &opponent),
+                1 => candidate.research_continuation_sweep(1, 0, &own, &opponent),
+                _ => candidate.research_continuation_sweep(1, 1, &[], &opponent),
+            };
+            assert!(result.is_err());
+            assert!(!candidate.player0_reach_current);
+            assert_reach_reuse_state(&candidate, &reference, "invalid continuation preserves device state");
+        }
+        for p in [0, 1] {
+            candidate.iterate().unwrap();
+            legacy_iteration(&mut reference);
+            assert!(candidate.player0_reach_current);
+            let own: Vec<f32> = (0..candidate.nh[p] as usize)
+                .map(|i| (i % 7 + 1) as f32 / 8.0).collect();
+            let opponent: Vec<f32> = (0..candidate.nh[1-p] as usize)
+                .map(|i| if i % 5 == 0 { -0.0 } else { (i % 11 + 1) as f32 / 16.0 }).collect();
+            let t = candidate.iteration + 1;
+            let actual = candidate.research_continuation_sweep(p, t, &own, &opponent).unwrap();
+            let expected = reference.research_continuation_sweep(p, t, &own, &opponent).unwrap();
+            assert_device_bits(&actual.into_iter().map(f32::to_bits).collect::<Vec<_>>(),
+                &expected.into_iter().map(f32::to_bits).collect::<Vec<_>>(), "continuation root CFVs");
+            assert!(!candidate.player0_reach_current);
+            assert_reach_reuse_state(&candidate, &reference, "changed-root continuation");
+            candidate.iterate().unwrap();
+            legacy_iteration(&mut reference);
+            assert_reach_reuse_state(&candidate, &reference, "first pair after changed-root continuation");
+        }
+    }
