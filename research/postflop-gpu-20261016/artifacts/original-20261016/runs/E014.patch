 }
 
+const MIN_DIRECT3_ACTION_SPAN: u32 = 4096;
+
+// Same-level nodes are independent. Preserve each bin's original order and
+// the aggregate spans; only training-up uses the three-action prefix counts.
+fn partition_direct3_actions(
+    nodes: &mut [u32], spans: &[LevelSpan], has_three_actions: impl Fn(u32) -> bool,
+) -> Vec<u32> {
+    let mut counts = Vec::with_capacity(spans.len());
+    let mut scratch = Vec::new();
+    for &span in spans {
+        let mut count = 0;
+        if span.count >= MIN_DIRECT3_ACTION_SPAN {
+            let level = &mut nodes[span.start as usize..(span.start + span.count) as usize];
+            scratch.clear();
+            scratch.extend(level.iter().copied().filter(|&node| has_three_actions(node)));
+            count = scratch.len() as u32;
+            if count > 0 && count < span.count {
+                scratch.extend(level.iter().copied().filter(|&node| !has_three_actions(node)));
+                level.copy_from_slice(&scratch);
+            }
+        }
+        counts.push(count);
+    }
+    counts
+}
