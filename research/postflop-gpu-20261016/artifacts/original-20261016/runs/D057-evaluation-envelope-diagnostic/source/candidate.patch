+// Exactly two timing-enabled events, owned by this solver's context/stream.
+// No event node, clone, upload, or modified graph execution is used.
+struct EvalEvents {
+    ctx: Arc<CudaContext>,
+    stream: Arc<CudaStream>,
+    handles: [sys::CUevent; 2],
+    record_counts: [usize; 2],
+}
+impl EvalEvents {
+    fn new(gpu: &GpuSolver) -> DiagResult<Self> {
+        let mut result = Self { ctx: gpu._ctx.clone(), stream: gpu.stream.clone(),
+            handles: [ptr::null_mut(); 2], record_counts: [0; 2] };
+        result.ctx.bind_to_thread().map_err(e)?;
+        for event in &mut result.handles {
+            unsafe { cu(sys::cuEventCreate(event, sys::CUevent_flags::CU_EVENT_DEFAULT as u32))?; }
+        }
+        Ok(result)
+    }
+    fn record(&mut self, index: usize) -> DiagResult<()> {
+        self.ctx.bind_to_thread().map_err(e)?;
+        unsafe { cu(sys::cuEventRecord(self.handles[index], self.stream.cu_stream()))?; }
+        self.record_counts[index] += 1;
+        Ok(())
+    }
+    fn elapsed(&self) -> DiagResult<f32> {
+        self.ctx.bind_to_thread().map_err(e)?;
+        let mut ms = 0f32;
+        unsafe { cu(sys::cuEventElapsedTime(&mut ms, self.handles[0], self.handles[1]))?; }
+        if !ms.is_finite() || ms < 0.0 { return Err("invalid evaluation event interval".into()); }
+        Ok(ms)
+    }
+    fn close(&mut self) -> DiagResult<()> {
+        if self.handles.iter().all(|x| x.is_null()) { return Ok(()); }
+        self.ctx.bind_to_thread().map_err(e)?;
+        let mut errors = Vec::new();
+        // A wait failure invalidates the diagnostic but must not skip destruction.
+        if let Err(error) = self.stream.synchronize().map_err(e) { errors.push(error); }
+        for event in &mut self.handles {
+            if !event.is_null() {
+                let result = unsafe { cu(sys::cuEventDestroy_v2(*event)) };
+                *event = ptr::null_mut();
+                if let Err(error) = result { errors.push(error); }
+            }
+        }
+        if errors.is_empty() { Ok(()) } else { Err(errors.join("; ")) }
+    }
+}
+impl Drop for EvalEvents {
+    fn drop(&mut self) {
+        if let Err(error) = self.close() {
+            let _ = writeln!(io::stderr().lock(), "D057_EVENT_CLEANUP_ERROR {error}");
+        }
+    }
+}
