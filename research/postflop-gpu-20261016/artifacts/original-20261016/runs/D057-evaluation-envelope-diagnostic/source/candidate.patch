+fn validate_exploit(gpu: &GpuSolver, exploit: f64, anchors: &Value) -> DiagResult<()> {
+    let expected=anchors.as_array().ok_or("anchor array")?.iter()
+        .find(|x|x["iteration"].as_u64()==Some(gpu.iteration as u64)).ok_or("missing iteration anchor")?;
+    if !exploit.is_finite() || Some(exploit.to_bits())!=expected["exploit_bits"].as_u64() {
+        return Err(format!("iteration{} exploit anchor mismatch: {}",gpu.iteration,exploit.to_bits()));
+    }
+    Ok(())
+}
+// Mechanically copied already-captured E020 evaluation path. No warm/capture fallback.
+fn measured_exploitability(gpu: &mut GpuSolver, solver: &Solver, events: &mut EvalEvents) -> DiagResult<f64> {
+    if !gpu.eval_warmed[1] || gpu.eval_graphs[1].is_none() || solver.spot.tree.config.rake_pct <= 0.0 {
+        return Err("sampled evaluation requires existing warmed raked graph".into());
+    }
+        let denom = solver.pair_weight_sum();
+        if denom <= 0.0 {
+            return Ok(f64::NAN);
+        }
+        let dot = |cfv: &[f32], p: usize| -> f64 {
+            solver.spot.weights[p]
+                .iter()
+                .zip(cfv.iter())
+                .map(|(&w, &v)| w as f64 * v as f64)
+                .sum::<f64>()
+                / denom
+        };
+        let raked = solver.spot.tree.config.rake_pct > 0.0;
+        let key = raked as usize;
+        // Warm kernels eagerly once, then capture the fixed evaluation work.
+        // Root copies remain on device until a single host download. Dot products
+        // below retain the original f64 order and normalization exactly.
+        let roots = {
+            events.record(0)?;
+            gpu.eval_graphs[key].as_ref().unwrap().launch().map_err(e)?;
+            events.record(1)?;
+            gpu.stream.clone_dtoh(&gpu.d_eval_roots).map_err(e)?
+        };
+        let mut br = [0f64; 2];
+        let mut v = [0f64; 2];
+        for p in 0..2 {
+            let off = 2 * p * gpu.nh_max as usize;
+            br[p] = dot(&roots[off..off + gpu.nh[p] as usize], p);
+            if raked {
+                let off = off + gpu.nh_max as usize;
+                v[p] = dot(&roots[off..off + gpu.nh[p] as usize], p);
+            }
+        }
+        if solver.spot.tree.config.rake_pct > 0.0 {
+            // With rake the game is not zero-sum: compare against actual EVs.
+            Ok(((br[0] - v[0]) + (br[1] - v[1])) / 2.0)
+        } else {
+            Ok((br[0] + br[1]) / 2.0)
+        }
+}
+fn sampled_batch(gpu: &mut GpuSolver, host: &Solver, mut events: Option<&mut EvalEvents>) -> DiagResult<(f64,f64)> {
+    let wall=Instant::now();
+    for _ in 0..20 { gpu.iterate()?; }
+    // No synchronize, readback, logging or state inspection before evaluation.
+    let exploit=match events.as_mut() {
+        Some(events) => measured_exploitability(gpu,host,events)?,
+        None => gpu.exploitability(host)?,
+    };
+    let host_ms=wall.elapsed().as_secs_f64()*1000.;
+    if !host_ms.is_finite() || host_ms<=0. { return Err("invalid host batch interval".into()); }
+    Ok((host_ms,exploit))
+}
