+fn checkpoint(native: &mut GpuSolver, instrumented: &mut GpuSolver,
+    host_a: &mut Solver, host_b: &mut Solver, iteration: u32, exploit: f64) -> DiagResult<()> {
+    compare_post_raw(native,instrumented,iteration)?;
+    native.sync_to_cpu(host_a)?; instrumented.sync_to_cpu(host_b)?;
+    compare_cpu(host_a,host_b)?;
+    emit(json!({"stage":"checkpoint_exact","iteration":iteration,"post_evaluation":true,
+        "raw_and_compressed_pass":true,"exploit_bits":exploit.to_bits()}))
+}
+fn diagnostic() -> DiagResult<()> {
+    let anchor:Value=serde_json::from_str(ANCHOR_JSON).map_err(e)?;
+    let convergence:Value=serde_json::from_str(CONVERGENCE_JSON).map_err(e)?;
+    let free_before_spot=available_ram()?;
+    if free_before_spot<16*GIB { return Err("less than16GiB available RAM before shared Spot build".into()); }
+    let config:SpotConfig=serde_json::from_value(anchor["config"].clone()).map_err(e)?;
+    let spot=Arc::new(Spot::new(config)?);
+    if spot.config.board!="Ks7s2d" || spot.tree.config.rake_cap!=3.0 || spot.tree.config.rake_pct!=0.05 {
+        return Err("diagnostic fixture differs from frozen config".into());
+    }
+    let plan=GpuPlan::build(&spot,true);
+    let device_per_arm=planned_device_bytes(&spot,&plan)?;
+    let dual_device=checked_sum(&[device_per_arm,device_per_arm,2*GIB])?;
+    let cpu_per_arm=spot.arena_bytes_for(Storage::Compressed);
+    let pinned_per_arm=(plan.arena_elements[0].max(plan.arena_elements[1]) as u64)
+        .checked_mul(4).ok_or("pinned bytes overflow")?;
+    // Reserve covers per-solver retained host layouts, constructor temporary plans,
+    // graph metadata/events and allocator overhead; raw pairwise copies are separately bounded.
+    let host_additional=checked_sum(&[cpu_per_arm,cpu_per_arm,pinned_per_arm,pinned_per_arm,CHUNK as u64*8,8*GIB])?;
+    let ram=available_ram()?;
+    let ctx=CudaContext::new(0).map_err(e)?;
+    let (free,total)=ctx.mem_get_info().map_err(e)?;
+    emit(json!({"stage":"admission","device_per_arm_payload_bytes":device_per_arm,
+        "dual_device_required_with_reserve":dual_device,"device_reserve_bytes":2*GIB,
+        "device_free_bytes":free,"device_total_bytes":total,"host_free_before_spot":free_before_spot,
+        "host_free_after_spot_and_plan":ram,"host_additional_required":host_additional,
+        "host_reserve_bytes":8*GIB,"cpu_arena_bytes_per_arm":cpu_per_arm,
+        "pinned_bytes_per_arm":pinned_per_arm,"shared_tree_bytes":spot.tree_bytes(),
+        "raw_compare_max_bytes":CHUNK*8,"diagnostic_only":true}))?;
+    if (free as u64)<dual_device || ram<host_additional { return Err("dual-arm memory admission refused".into()); }
+    if cpu_per_arm!=1_391_071_288 || plan.nh!=[258,320] || plan.num_nodes!=1_346_813 {
+        return Err("fixed two-tone geometry differs".into());
+    }
+    drop(plan);
+    let mut host_a=Solver::with_storage(spot.clone(),Storage::Compressed);
+    let mut host_b=Solver::with_storage(spot,Storage::Compressed);
+    if host_a.algo!=Algorithm::Dcfr || !host_a.use_isomorphism || !host_a.locks.is_empty()
+        || host_b.algo!=host_a.algo || !host_b.use_isomorphism || !host_b.locks.is_empty() {
+        return Err("unexpected solver defaults".into());
+    }
+    let mut native=SolverGuard(GpuSolver::new(&host_a)?);
+    native.synchronize()?;
+    let (free_before_second,_)=ctx.mem_get_info().map_err(e)?;
+    if (free_before_second as u64)<checked_sum(&[device_per_arm,2*GIB])? {
+        return Err("live memory changed before second solver allocation".into());
+    }
+    let mut candidate=SolverGuard(GpuSolver::new(&host_b)?);
+    candidate.synchronize()?;
+    if native.eval_warmed[1] || candidate.eval_warmed[1] || native.eval_graphs[1].is_some() || candidate.eval_graphs[1].is_some() {
+        return Err("fresh evaluation state unexpectedly warm".into());
+    }
+    let mut events=EvalEvents::new(&candidate)?;
+    let mut last_exploit=0.;
+    for check in 1..=7 {
+        for _ in 0..20 { native.iterate()?; }
+        let x=native.exploitability(&host_a)?;
+        for _ in 0..20 { candidate.iterate()?; }
+        let y=candidate.exploitability(&host_b)?;
+        validate_exploit(&native,x,&convergence)?; validate_exploit(&candidate,y,&convergence)?;
+        if x.to_bits()!=y.to_bits() || native.iteration!=check*20 || candidate.iteration!=check*20 {
+            return Err("warm checkpoint mismatch".into());
+        }
+        let captured=check>=2;
+        for gpu in [&*native,&*candidate] {
+            if !gpu.eval_warmed[1] || gpu.eval_graphs[1].is_some()!=captured {
+                return Err("normal evaluation warm/capture cadence differs".into());
+            }
+        }
+        last_exploit=x;
+        emit(json!({"stage":"warm_check","iteration":native.iteration,"exploit_bits":x.to_bits(),
+            "ordinary_eval_graph_present":native.eval_graphs[1].is_some(),
+            "instrumented_eval_graph_present":candidate.eval_graphs[1].is_some(),
+            "ordinary_eval_warmed":native.eval_warmed[1],"instrumented_eval_warmed":candidate.eval_warmed[1],
+            "normal_production_method_both_arms":true}))?;
