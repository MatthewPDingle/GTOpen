+// Secondary post140 metadata only: a multiset, not raw enumeration order.
+// All borrowed module/function handles remain owned by the live solver.
+fn graph_metadata(gpu: &GpuSolver) -> DiagResult<Value> {
+    gpu._ctx.bind_to_thread().map_err(e)?;
+    let graph = gpu.eval_graphs[1].as_ref().ok_or("raked evaluation graph absent at140")?;
+    let mut count = 0usize;
+    unsafe { cu(sys::cuGraphGetNodes(graph.cu_graph(), ptr::null_mut(), &mut count))?; }
+    let mut nodes = vec![ptr::null_mut(); count];
+    unsafe { cu(sys::cuGraphGetNodes(graph.cu_graph(), nodes.as_mut_ptr(), &mut count))?; }
+    if count != nodes.len() || nodes.iter().any(|x| x.is_null()) { return Err("unstable graph node enumeration".into()); }
+    let names = ["copy_root", "down_action", "down_chance", "up_fold", "up_show",
+        "up_chance", "up_action", "up_action_eval"];
+    let mut known = BTreeMap::new();
+    let mut module: sys::CUmodule = ptr::null_mut();
+    let mut kinds: BTreeMap<String, usize> = BTreeMap::new();
+    let mut kernels = Vec::new();
+    for node in nodes {
+        let mut kind = sys::CUgraphNodeType::CU_GRAPH_NODE_TYPE_KERNEL;
+        unsafe { cu(sys::cuGraphNodeGetType(node, &mut kind))?; }
+        *kinds.entry(format!("{kind:?}")).or_default() += 1;
+        if kind == sys::CUgraphNodeType::CU_GRAPH_NODE_TYPE_KERNEL {
+            let mut params: sys::CUDA_KERNEL_NODE_PARAMS = unsafe { std::mem::zeroed() };
+            unsafe { cu(sys::cuGraphKernelNodeGetParams_v2(node, &mut params))?; }
+            let mut own_module = ptr::null_mut();
+            unsafe { cu(sys::cuFuncGetModule(&mut own_module, params.func))?; }
+            if module.is_null() {
+                module = own_module;
+                for name in names {
+                    let name_c = CString::new(name).map_err(e)?;
+                    let mut function = ptr::null_mut();
+                    unsafe { cu(sys::cuModuleGetFunction(&mut function, module, name_c.as_ptr()))?; }
+                    known.insert(function as usize, name);
+                }
+            } else if module != own_module { return Err("evaluation kernels span unexpected modules".into()); }
+            let name = known.get(&(params.func as usize)).ok_or("unknown own-module evaluation function")?;
+            // Never dereference kernelParams/extra or compare pointer-bearing structs.
+            kernels.push(json!({"kernel":name,
+                "grid":[params.gridDimX,params.gridDimY,params.gridDimZ],
+                "block":[params.blockDimX,params.blockDimY,params.blockDimZ],
+                "shared_bytes":params.sharedMemBytes}));
+        }
+    }
+    if kernels.is_empty() { return Err("empty captured evaluation kernel set".into()); }
+    kernels.sort_by_key(|v| v.to_string());
+    Ok(json!({"node_count":count,"node_kinds":kinds,"kernel_descriptors_sorted":kernels,
+        "comparison":"logical multiset only; no raw handles, arguments, memcpy addresses or edges"}))
+}
+fn compare_post_raw(a: &GpuSolver, b: &GpuSolver, iteration: u32) -> DiagResult<()> {
+    a.synchronize()?; b.synchronize()?;
+    if a.iteration != iteration || b.iteration != iteration { return Err("raw checkpoint iteration mismatch".into()); }
+    let mut records = Vec::new();
+    for p in 0..2 {
+        for (name, left, right) in [("regrets",&a.d_regrets[p],&b.d_regrets[p]),
+            ("strategy",&a.d_strat[p],&b.d_strat[p]), ("reach",&a.d_reach[p],&b.d_reach[p]),
+            ("weights",&a.d_weights[p],&b.d_weights[p])] {
+            if left.len()!=right.len() { return Err(format!("{name}/{p} length mismatch")); }
+            let mut hash = Fingerprint::new();
+            for offset in (0..left.len()).step_by(CHUNK) {
+                let end = (offset+CHUNK).min(left.len());
+                let x=a.stream.clone_dtoh(&left.slice(offset..end)).map_err(e)?;
+                let y=b.stream.clone_dtoh(&right.slice(offset..end)).map_err(e)?;
+                for (i,(x,y)) in x.iter().zip(&y).enumerate() {
+                    if x.to_bits()!=y.to_bits() { return Err(format!("raw {name}/{p}/{}: {:08x}!={:08x}",offset+i,x.to_bits(),y.to_bits())); }
+                    hash.bytes(&x.to_bits().to_le_bytes());
+                }
+            }
+            records.push(json!({"array":name,"player":p,"entries":left.len(),"hash":hash.finish()}));
+        }
+    }
+    for p in 0..2 {
+        for mode in 0..2 {
+            let off=(2*p+mode)*a.nh_max as usize;
+            let len=a.nh[p] as usize;
+            if a.nh!=b.nh || a.nh_max!=b.nh_max { return Err("root geometry mismatch".into()); }
+            let x=a.stream.clone_dtoh(&a.d_eval_roots.slice(off..off+len)).map_err(e)?;
+            let y=b.stream.clone_dtoh(&b.d_eval_roots.slice(off..off+len)).map_err(e)?;
+            let mut hash=Fingerprint::new();
+            for (x,y) in x.iter().zip(&y) {
+                if x.to_bits()!=y.to_bits() { return Err(format!("evaluation root{p}/{mode} differs")); }
+                hash.bytes(&x.to_bits().to_le_bytes());
+            }
+            records.push(json!({"array":"evaluation_root","player":p,"mode":mode,"entries":len,"hash":hash.finish()}));
+        }
+    }
+    let disc=Discounts::for_iteration(a.algo,iteration);
+    let expected=[disc.pos.to_bits(),disc.neg.to_bits(),disc.strat.to_bits()];
+    for gpu in [a,b] {
+        let actual=gpu.stream.clone_dtoh(&gpu.d_disc).map_err(e)?;
+        if actual.iter().map(|x|x.to_bits()).collect::<Vec<_>>()!=expected { return Err("discount payload differs".into()); }
+    }
+    emit(json!({"stage":"raw_exact","iteration":iteration,"pass":true,"arrays":records,
+        "discount_bits":expected,"chunk_floats":CHUNK,"peak_pairwise_snapshot_bytes":CHUNK*8,
+        "cfv_scratch_compared":false,"before_exploitability":false,"post_evaluation":true}))
+}
