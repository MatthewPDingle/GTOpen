+// Diagnostic-only host timers; no CUDA calls, events, or additional waits.
+#[derive(serde::Serialize)]
+struct QuantizedInitSpan {
+    stage: &'static str,
+    player: Option<usize>,
+    wall_ms: f64,
+}
+struct QuantizedInitTrace {
+    started: Option<std::time::Instant>,
+    last: Option<std::time::Instant>,
+    spans: Vec<QuantizedInitSpan>,
+}
+impl QuantizedInitTrace {
+    fn new() -> Self {
+        let enabled = std::env::var_os("POSTFLOP_AUTORESEARCH_QUANTIZED_INIT_PROFILE")
+            .as_deref() == Some(std::ffi::OsStr::new("1"));
+        let started = enabled.then(std::time::Instant::now);
+        Self { started, last: started, spans: Vec::with_capacity(if enabled { 24 } else { 0 }) }
+    }
+    fn mark(&mut self, stage: &'static str, player: Option<usize>) {
+        if let Some(last) = self.last {
+            let now = std::time::Instant::now();
+            let wall_ms = now.duration_since(last).as_secs_f64() * 1e3;
+            if wall_ms.is_finite() {
+                self.spans.push(QuantizedInitSpan { stage, player, wall_ms });
+            }
+            self.last = Some(now);
+        }
+    }
+    fn finish(self, outcome: &'static str) {
+        if let Some(started) = self.started {
+            let wall_ms_before_logging = started.elapsed().as_secs_f64() * 1e3;
+            if !wall_ms_before_logging.is_finite() { return; }
+            use std::io::Write;
+            let mut stderr = std::io::stderr().lock();
+            let _ = writeln!(stderr, "QUANTIZED_INIT_PROFILE {}", serde_json::json!({
+                "schema_version": 1, "phase": "quantized_try_new", "outcome": outcome,
+                "clock": "host_wall", "diagnostic_only": true,
+                "environment": {
+                    "POSTFLOP_AUTORESEARCH_QUANTIZED_INIT_PROFILE": "1",
+                    "CUDA_MODULE_LOADING": std::env::var("CUDA_MODULE_LOADING").ok()
+                },
+                "extra_cuda_synchronizations": 0,
+                "wall_ms_before_logging": wall_ms_before_logging, "spans": self.spans,
+                "note": "Host-call spans may submit asynchronous work. Existing wait spans drain pending stream work; they are not isolated kernel/device times. Logging and timers perturb constructor time; exclude this run from qualification."
+            }));
+        }
+    }
+}
