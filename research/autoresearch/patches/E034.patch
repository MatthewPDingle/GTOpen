+            for (; t < c1; t++) {
+                u32 pos = o_card_pos[t];
+                if (pos >= ub) break;
+                tot_c += reach_sh[pos];
+            }
+            for (; t < c1; t++) {
+                float r = reach_sh[o_card_pos[t]];
+                tot_c += r;
+                higher_c += r;
             }
