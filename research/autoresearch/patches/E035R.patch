+            *v = f32::from_bits(patterns[(i * 17 + i / NUM_CLASSES) % patterns.len()]);
+        }
+        inputs[..NUM_CLASSES].fill(0.0);
+        inputs[NUM_CLASSES..2 * NUM_CLASSES].fill(-0.0);
+        inputs[2 * NUM_CLASSES..3 * NUM_CLASSES].fill(f32::from_bits(1));
