-    }
-    fn build(plan: &EquityCachePlan, np: usize) -> Result<Self, String> {
-        let union = plan.blocks.len();
-        if union == 0 { return Ok(Self::union(0)); }
-        let capacity = plan.spans[..np].iter().map(|&(_, n)| n as usize).max().unwrap_or(0);
